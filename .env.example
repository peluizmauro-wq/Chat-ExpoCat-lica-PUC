# Copie este arquivo para .env
# O sistema funciona em modo local sem chave.

# LLM opcional
OPENAI_API_KEY=cole_sua_chave_aqui
OPENAI_MODEL=gpt-4.1-mini

# Observabilidade Langfuse
LANGFUSE_PUBLIC_KEY=cole_sua_public_key_aqui
LANGFUSE_SECRET_KEY=cole_sua_secret_key_aqui
LANGFUSE_BASE_URL=https://cloud.langfuse.com
